pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Pemarinzindeolkar/DSO101_02250362.git',
                    credentialsId: 'github-pat'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm install
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm run build || echo "No build script defined"
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm test
                    '''
                }
            }
            post {
                always {
                    junit 'A2/junit.xml'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    // Build and tag using full docker path
                    sh """
                        cd A2
                        /usr/local/bin/docker build -t pemarinzindeolkar17/be-todo:latest .
                        /usr/local/bin/docker tag pemarinzindeolkar17/be-todo:latest pemarinzindeolkar17/be-todo:${BUILD_NUMBER}
                        /usr/local/bin/docker tag pemarinzindeolkar17/be-todo:latest pemarinzindeolkar17/be-todo:jenkins-${BUILD_NUMBER}
                    """
                    
                    // Push using shell commands instead of docker.withRegistry
                    sh """
                        echo 'prdeolkar7' | /usr/local/bin/docker login -u pemarinzindeolkar17 --password-stdin
                        /usr/local/bin/docker push pemarinzindeolkar17/be-todo:${BUILD_NUMBER}
                        /usr/local/bin/docker push pemarinzindeolkar17/be-todo:jenkins-${BUILD_NUMBER}
                        /usr/local/bin/docker push pemarinzindeolkar17/be-todo:latest
                        /usr/local/bin/docker logout
                        echo "✅ Successfully pushed to Docker Hub"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline completed successfully!"
            echo "📦 Build Number: ${BUILD_NUMBER}"
            echo "🐳 Docker images pushed with tags: ${BUILD_NUMBER}, jenkins-${BUILD_NUMBER}, latest"
        }
        failure {
            echo "❌ Pipeline failed. Check the logs above."
        }
    }
}
