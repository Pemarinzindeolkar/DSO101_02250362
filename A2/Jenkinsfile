pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Pemarinzindeolkar/DSO101_02250362.git',
                    credentialsId: 'github-pat'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm install
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm run build || echo "No build script defined"
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm test
                    '''
                }
            }
            post {
                always {
                    junit 'A2/junit.xml'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    sh """
                        cd A2
                        echo "Building Docker image..."
                        /usr/local/bin/docker build -t pemarinzindeolkar17/be-todo:latest .
                        /usr/local/bin/docker tag pemarinzindeolkar17/be-todo:latest pemarinzindeolkar17/be-todo:${BUILD_NUMBER}
                        /usr/local/bin/docker tag pemarinzindeolkar17/be-todo:latest pemarinzindeolkar17/be-todo:jenkins-${BUILD_NUMBER}
                        
                        echo "Docker build complete!"
                        /usr/local/bin/docker images | grep pemarinzindeolkar17
                    """
                    
                    // Push to Docker Hub
                    docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') {
                        docker.image("pemarinzindeolkar17/be-todo:${BUILD_NUMBER}").push()
                        docker.image("pemarinzindeolkar17/be-todo:jenkins-${BUILD_NUMBER}").push()
                        docker.image("pemarinzindeolkar17/be-todo:latest").push()
                    }
                    
                    echo "✅ Successfully built and pushed to Docker Hub: pemarinzindeolkar17/be-todo:${BUILD_NUMBER}"
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline completed successfully!"
            echo "📦 Build Number: ${BUILD_NUMBER}"
            echo "🐳 Docker image: pemarinzindeolkar17/be-todo:${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Pipeline failed. Check the logs above."
        }
    }
}