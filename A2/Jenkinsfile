pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Pemarinzindeolkar/DSO101_02250362.git',
                    credentialsId: 'github-pat'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('A2') {
                    sh 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir('A2') {
                    sh 'npm run build || echo "No build script defined"'
                }
            }
        }

        stage('Test') {
            steps {
                dir('A2') {
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit 'A2/junit.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage ready - Docker integration optional'
            }
        }
    }

    post {
        always {
            // cleanWs()  ← COMMENT THIS OUT OR REMOVE IT
            echo 'Build completed'
        }
    }
}