pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Pemarinzindeolkar/DSO101_02250362.git',
                    credentialsId: 'github-pat'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm install
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm run build || echo "No build script defined"
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('A2') {
                    sh '''
                        export PATH=/Users/pema/.nvm/versions/node/v20.20.2/bin:$PATH
                        npm test
                    '''
                }
            }
            post {
                always {
                    junit 'A2/junit.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage ready'
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'
        }
    }
}